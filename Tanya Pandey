<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TANYA PANDYA - Cricket Prediction Expert</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #0d1117; /* Dark background inspired by modern UIs */
            color: #e6e6e6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            text-align: center;
            overflow-x: hidden;
            position: relative;
        }
        /* Background gradient overlay for a modern look */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #1a2a47 0%, #0d1117 100%);
            opacity: 0.95;
            z-index: -1;
        }

        .container {
            background: rgba(255, 255, 255, 0.05); /* Slightly transparent white for glass effect */
            backdrop-filter: blur(10px); /* Glassmorphism effect */
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 40px;
            max-width: 800px;
            margin: 20px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
            position: relative;
            z-index: 1;
            animation: fadeIn 1s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .logo {
            margin-bottom: 25px;
            width: 150px; /* Adjust logo size as needed */
            height: auto;
        }

        h1 {
            color: #ffcc00; /* Gold/Yellow for highlights */
            font-size: 2.8em;
            margin-bottom: 15px;
            letter-spacing: 1px;
        }

        h2 {
            color: #e0e0e0;
            font-size: 1.6em;
            margin-bottom: 30px;
            font-weight: 400;
        }

        .profile-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .profile-image {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #ffcc00;
            box-shadow: 0 0 15px rgba(255, 204, 0, 0.5);
            animation: pulseBorder 2s infinite ease-in-out;
        }

        @keyframes pulseBorder {
            0% { box-shadow: 0 0 15px rgba(255, 204, 0, 0.5); }
            50% { box-shadow: 0 0 25px rgba(255, 204, 0, 0.8); }
            100% { box-shadow: 0 0 15px rgba(255, 204, 0, 0.5); }
        }

        .description {
            font-size: 1.1em;
            line-height: 1.6;
            margin-bottom: 25px;
            max-width: 600px;
            color: #c0c0c0;
        }

        .features-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin: 30px auto;
            max-width: 500px;
            text-align: left;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.05em;
            color: #e0e0e0;
        }

        .feature-item svg {
            color: #33cc33; /* Green for checkmarks */
            font-size: 1.3em;
        }

